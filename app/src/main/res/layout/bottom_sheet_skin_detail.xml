<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#161822" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView android:id="@+id/ivDetailImage" android:layout_height="200dp" android:layout_width="match_parent" android:scaleType="fitCenter"/>

    <TextView android:id="@+id/tvDetailWeapon" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:textColor="#94A3B8" android:textSize="14sp"/>

    <TextView android:id="@+id/tvDetailName" android:layout_height="wrap_content" android:layout_width="wrap_content" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>

    <TextView android:id="@+id/tvDetailDescription" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_width="match_parent" android:textColor="#CBD5E1" android:textSize="14sp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoveSkin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#2B1D24"
        android:text="REMOVE FROM LOADOUT"
        android:textColor="#F87171"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</LinearLayout>